FROM python:3.12-slim

WORKDIR /app

# Install deps first for layer caching.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the app AND the precomputed reports (generated by scripts/build_reports.py).
# Reports are .gitignored, so the deploy build context MUST contain api/reports/.
COPY . .

EXPOSE 8080

# Honor $PORT if the platform sets one, default to 8080.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
